# SidStack Server — Environment Configuration
# Copy this to .env and fill in your values

# ===========================================================================
# Core Services
# ===========================================================================

# API authentication (required for production)
SIDSTACK_API_KEY=sk-change-me-to-a-secure-key

# MCP authentication (optional, falls back to SIDSTACK_API_KEY)
# SIDSTACK_MCP_KEY=

# CORS origins for Web UI (comma-separated)
# SIDSTACK_CORS_ORIGINS=https://app.sidstack.dev

# Custom ports (defaults shown)
# API_PORT=19432
# MCP_PORT=19433

# ===========================================================================
# Reverse Proxy (Caddy)
# ===========================================================================

# Domain names (must point to this server's IP)
API_DOMAIN=api.sidstack.dev
MCP_DOMAIN=mcp.sidstack.dev
BOT_DOMAIN=bot.sidstack.dev
APP_DOMAIN=app.sidstack.dev

# Web UI API URL (injected at build time)
# Leave empty to use relative /api/* proxy (recommended)
# VITE_API_URL=https://api.sidstack.dev
# WEB_UI_PORT=5174

# ===========================================================================
# Semantic Memory (optional)
# ===========================================================================

# Qdrant vector database (external)
QDRANT_HOST=your-qdrant-host
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=sidstack_mem0

# LiteLLM Gateway
LITELLM_MASTER_KEY=sk-change-me

# Provider API keys
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Model selection
LLM_MODEL=gemini-flash
EMBED_MODEL=gemini-embedding

# mem0 API key
MEM0_API_KEY=
